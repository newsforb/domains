<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Imperial Trade Global | Premium Domains For Sale</title>

<meta name="description" content="Premium brandable domains available for startups, technology, beauty, lifestyle, media and global businesses.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">


<style>

:root{
--gold:#fbbf24;
--purple:#8b5cf6;
--pink:#ec4899;
--dark:#020617;
--muted:#94a3b8;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{

font-family:'Poppins',sans-serif;

background:
radial-gradient(circle at top,#1e3a8a,#020617 55%);

color:white;

}


nav{

position:sticky;
top:0;
z-index:100;

background:rgba(2,6,23,.85);

backdrop-filter:blur(15px);

padding:22px 8%;

display:flex;

justify-content:space-between;

align-items:center;

border-bottom:1px solid rgba(255,255,255,.1);

}


.logo{

font-size:26px;

font-weight:800;

background:
linear-gradient(90deg,#fbbf24,#f97316);

-webkit-background-clip:text;

color:transparent;

}


nav a{

color:white;

text-decoration:none;

font-weight:600;

}



.hero{

min-height:85vh;

display:flex;

justify-content:center;

align-items:center;

text-align:center;

padding:80px 20px;

background:

linear-gradient(
135deg,
rgba(30,58,138,.9),
rgba(124,58,237,.85),
rgba(236,72,153,.8)
);

}



.hero h1{

font-size:clamp(42px,7vw,80px);

font-weight:800;

margin-bottom:25px;

}



.hero p{

max-width:850px;

margin:auto;

font-size:22px;

line-height:1.7;

}



.btn{

display:inline-block;

margin-top:35px;

padding:16px 40px;

border-radius:50px;

background:white;

color:#7c3aed;

font-weight:700;

text-decoration:none;

transition:.3s;

}


.btn:hover{

transform:translateY(-5px);

}



.container{

max-width:1300px;

margin:auto;

padding:90px 25px;

}



.title{

text-align:center;

font-size:45px;

margin-bottom:50px;

}



.search{

display:block;

width:100%;

max-width:500px;

margin:0 auto 50px;

padding:16px 25px;

border-radius:50px;

border:none;

font-size:16px;

}



.grid{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(320px,1fr));

gap:30px;

}



.card{

background:

linear-gradient(
145deg,
rgba(255,255,255,.1),
rgba(255,255,255,.03)
);

border:1px solid rgba(255,255,255,.12);

padding:35px;

border-radius:25px;

backdrop-filter:blur(15px);

transition:.35s;

}



.card:hover{

transform:translateY(-10px);

box-shadow:

0 25px 60px rgba(0,0,0,.4);

border-color:#fbbf24;

}



.badge{

display:inline-block;

background:#22c55e;

padding:7px 15px;

border-radius:30px;

font-size:12px;

font-weight:700;

}



.domain{

font-size:30px;

font-weight:800;

color:#93c5fd;

margin:20px 0;

word-break:break-word;

}



.card p{

color:var(--muted);

line-height:1.7;

min-height:85px;

}



.buy{

display:inline-block;

margin-top:25px;

padding:13px 30px;

border-radius:50px;

background:

linear-gradient(
90deg,
#fbbf24,
#f97316
);

color:#111827;

font-weight:800;

text-decoration:none;

}



.buy:hover{

opacity:.85;

}



.contact{

background:white;

color:#111827;

padding:90px 20px;

text-align:center;

}



.contact h2{

font-size:42px;

margin-bottom:20px;

}



.contact p{

max-width:850px;

margin:auto;

font-size:19px;

line-height:1.8;

color:#475569;

}



footer{

background:#000;

padding:40px;

text-align:center;

color:#64748b;

}



@media(max-width:700px){

.hero h1{

font-size:42px;

}

.hero p{

font-size:18px;

}

.title{

font-size:32px;

}

}

</style>

</head>


<body>


<nav>

<div class="logo">

Imperial Trade Global

</div>

<a href="#domains">

Domains

</a>

</nav>



<section class="hero">

<div>


<h1>

Premium Domains For Global Brands

</h1>


<p>

Secure memorable digital assets designed for companies in technology,
beauty, wellness, lifestyle, media and international commerce.

</p>


<a class="btn" href="#domains">

View Available Domains

</a>


</div>

</section>




<section class="container" id="domains">


<h2 class="title">

Premium Domain Portfolio

</h2>



<input 
class="search"
id="search"
placeholder="Search domains..."
>



<div class="grid" id="domainGrid"></div>


</section>




<section class="contact">


<h2>

Interested In A Domain?

</h2>


<p>

Contact <strong>info@imperialtradeglobal.com</strong>
to discuss pricing, offers and ownership transfer
for any available premium domain.

</p>


</section>




<footer>

© 2026 Imperial Trade Global<br>

Premium Digital Assets

</footer>




<script>


const domains=[


[
"coelestia.com",
"Luxury celestial-inspired brand for AI, technology, wellness, fashion and lifestyle companies."
],


[
"crazedbeauty.com",
"Premium beauty brand name for cosmetics, skincare, salons and online retailers."
],


[
"eternalmaterialist.com",
"Distinctive luxury identity for fashion, design and creative businesses."
],


[
"harryshome.shop",
"Perfect ecommerce domain for furniture, home décor and lifestyle products."
],


[
"imperialtradeglobal.com",
"Professional global trade and commerce brand."
],


[
"internationalfieldproduction.com",
"Strong media production domain for film, television and documentary companies."
],


[
"smartypilates.com",
"Memorable wellness brand for Pilates studios and fitness platforms."
]


];



function renderDomains(list){


const grid=document.getElementById("domainGrid");

grid.innerHTML="";


list.forEach(domain=>{


grid.innerHTML += `


<div class="card">


<span class="badge">

AVAILABLE

</span>


<div class="domain">

${domain[0]}

</div>


<p>

${domain[1]}

</p>


<a class="buy"
href="mailto:info@imperialtradeglobal.com?subject=Domain Purchase Inquiry - ${domain[0]}">

Contact Owner

</a>


</div>


`;

});


}



renderDomains(domains);



document.getElementById("search")
.addEventListener("input",function(){


let value=this.value.toLowerCase();


renderDomains(

domains.filter(
domain=>domain[0].toLowerCase().includes(value)
)

);


});


</script>


</body>

</html>
```
